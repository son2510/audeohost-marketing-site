<section id="cases" class="block tint">
  <div class="wrap">
    <div class="block-head">
      <span class="eyebrow">{{ cases.eyebrow | safe }}</span>
      <h2>{{ cases.heading | safe }}</h2>
      <p>{{ cases.subhead | safe }}</p>
    </div>
    <div class="cards3">
      {%- for card in cases.cards %}
      <div class="card">
        <span class="tag">{{ card.tag | safe }}</span>
        <h3>{{ card.title | safe }}</h3>
        <ul>{%- for item in card.items %}<li>{{ item | safe }}</li>{%- endfor %}</ul>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
